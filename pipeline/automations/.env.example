# Copy to .env.local and fill in values for local development with Trigger.dev.

# --- Trigger.dev ---
TRIGGER_PROJECT_ID=        # Optional: override Trigger.dev project ref (defaults to proj_ai_sdr_engine)

# --- Core (all agents) ---
ANTHROPIC_API_KEY=
DATABASE_URL=              # Neon connection string

# --- Researcher ---
FIRECRAWL_API_KEY=
AI_SDR_HOLDOUT_PCT=20      # % of accounts/day routed to BDR raw queue (control group)

# --- Slack approval (writer, scorer) ---
SLACK_BOT_TOKEN=
AI_SDR_APPROVAL_CHANNEL=   # Slack channel ID for approval messages

# --- Sender: ReachInbox (active adapter) ---
REACHINBOX_API_KEY=
REACHINBOX_CAMPAIGN_ID=    # campaign holding the {{ai_subject}}/{{ai_body}} template
REACHINBOX_FROM_ADDRESS=   # optional — address recorded on the send log

# --- Sender: Smartlead adapter (legacy stub — not routed to) ---
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_ID=

# --- Sender: Gmail adapter (legacy stub — not routed to) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=        # mailbox we send from

# --- Reply handler ---
AI_SDR_REPLY_WEBHOOK_SECRET=   # HMAC verification on inbound reply webhook

# --- SFDC (sender + reply-handler activity write) ---
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
